<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- STT audio capture -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Gemini API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".CatchApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Catch">

        <!-- We drive WorkManager's Configuration ourselves (CatchApplication
             implements Configuration.Provider) so Hilt-injected workers get
             constructed correctly. That means the default androidx.startup
             WorkManager initializer must be switched off, or it'll try to
             build workers without the Hilt factory and crash on first run. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Catch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Transparent trampoline that does the actual listening. Launched
             from the QS tile (a different process — System UI), so it must
             be exported, and showWhenLocked/turnScreenOn so "works from the
             lock screen" (per the brief) is actually true, not aspirational. -->
        <activity
            android:name=".capture.CaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.Catch" />

        <service
            android:name=".capture.CaptureTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_mic"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
